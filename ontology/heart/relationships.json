{
  "ontology_id": "lagnav.heart",
  "title": "Heart Ontology v0.1 - typed relationships",
  "version": "0.1.0",
  "schema_version": "awr-ontology-1",
  "status": "DRAFT_UNVALIDATED",
  "description": "Explicit typed edges for the three AWR graphs. The relation vocabulary itself (graph assignment, symmetry, inverses, flow semantics) is defined in code in awr/relationships.py; every 'relation' below is validated against that registry at load time. Edges are NOT free text.",
  "conventions": {
    "graphs": "Each relation type belongs to exactly one graph: STRUCTURE, SPATIAL or FUNCTIONAL.",
    "hierarchy_derived": "part_of / contains edges for the organisational tree are derived automatically from hierarchy.json and are NOT repeated here. The part_of edges listed here assert anatomical containment that the presentation tree does not express.",
    "symmetric": "Symmetric relations (connects_to, adjacent_to, continuous_with) are declared once; queries resolve both directions.",
    "inverses": "Inverse pairs (superior_to/inferior_to, anterior_to/posterior_to, left_of/right_of, inside/surrounds, part_of/contains) are declared in one direction only; queries resolve the inverse.",
    "laterality": "left_of / right_of use anatomical left and right (the subject's own left and right), not viewer left and right.",
    "granularity": "Functional flow edges carry a granularity tag: 'detailed' edges route through valves, 'summary' edges are chamber-level shortcuts used when valves are out of scope, 'any' edges are valid at every level. The animation layer selects a granularity so it never double-counts parallel paths."
  },
  "edges": [
