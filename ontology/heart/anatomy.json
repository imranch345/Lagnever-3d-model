  "description": "Entity catalogue for the Lagnav 3D heart prototype. This is an engineering-grade v0.1 vocabulary intended to exercise the Anatomical World Representation (AWR). It is NOT a validated medical ontology and MUST NOT be presented as clinically authoritative. Hierarchy lives in hierarchy.json; typed relations live in relationships.json.",
  "provenance": {
    "authored_by": "Lagnav 3D R&D",
    "derived_from": "General anatomical common knowledge, hand-authored for this prototype. No third-party ontology, atlas, dataset or copyrighted asset was imported.",
    "external_ontology_alignment": {
      "status": "not_started",
      "todo": "A later R&D step will align entity ids with FMA / UBERON / SNOMED CT identifiers under their respective licence terms, and record per-entity source references in 'source_refs'."
    },
    "review_state": "no clinical review has been performed"
  },
  "conventions": {
    "entity_id": "Stable opaque identifier. Namespaced with a leading 'heart.' for readability ONLY. It is NOT derived from the hierarchy path, so re-parenting an entity never changes its identity.",
    "lod": "min_lod is the lowest level of detail at which the entity is visible by default. max_lod (nullable) is the highest. Entities always EXIST in the scene regardless of the active LOD; LOD controls default visibility only.",
    "groups": "Entities with is_group=true are organisational containers (not tissue). They are not renderable; commands that target them expand to their renderable descendants.",
    "laterality": "left | right | median | none"
  },
